# Variables públicas de Vite; se incorporan durante npm run build.
VITE_APP_BACKEND=https://pre-designer-api.example.com
VITE_AUTH_SERVICE_BACKEND=https://pre-auth.example.com
VITE_WORKBENCH_URL=https://pre-workbench.example.com

# Usar la clave pública real y autorizar el dominio en Turnstile.
VITE_TURNSTILE_ENABLED=true
VITE_CLOUDFLARE_SITE_KEY=replace-with-your-public-turnstile-site-key
